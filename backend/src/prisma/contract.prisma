// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  name      String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  groupMembers GroupMember[]
  expensesPaid Expense[]
  splits ExpenseSplit[]
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  members GroupMember[]
  expenses Expense[]
}


model GroupMember {
  groupId Int
  userId Int
  group Group @relation(fields:[groupId],references:[id])
  user User @relation(fields:[userId],references:[id])
  joinedAt TimestamptzString @default(now())
  @@id([groupId,userId])
}

model Expense{
  id Int @id @default(autoincrement())
  groupId Int
  paidBy Int
  amount Int
  description String?
  createdAt TimestamptzString @default(now())

  group Group @relation(fields:[groupId],references:[id])
  payer User @relation(fields:[paidBy],references:[id])
  splits ExpenseSplit[]
}

model ExpenseSplit{
   expenseId Int
   userId  Int
   amount Int

   expense Expense @relation(fields: [expenseId],references:[id])
   user User @relation(fields: [userId],references:[id])
  
   @@id([expenseId,userId])
}